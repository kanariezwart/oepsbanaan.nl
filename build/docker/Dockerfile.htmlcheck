# HTML validation using vnu.jar (Nu HTML Checker)
# Pinned to an explicit Alpine variant to reduce drift and improve Scout recommendations.

FROM eclipse-temurin:21-jre-alpine-3.22

WORKDIR /opt
# Use upstream-supported "latest" asset endpoint.
ADD https://github.com/validator/validator/releases/download/latest/vnu.jar /opt/vnu.jar

WORKDIR /work
ENTRYPOINT ["java", "-jar", "/opt/vnu.jar"]
